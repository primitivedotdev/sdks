  "handle_cases": [
    {
      "name": "accepted_signed",
      "body_fixture": [
        "sent-email-events",
        "accepted.json"
      ],
      "headers": {
        "Primitive-Signature": "{signed}",
        "X-Webhook-Event": "sent_email.accepted",
        "X-Webhook-Id": "1a2b3c4d-0001-4000-8000-000000000001"
      },
      "secret": "whsec_test_sent_email",
      "expected": {
        "valid": true,
        "event": "sent_email.accepted",
        "id": "1a2b3c4d-0001-4000-8000-000000000001"
      }
    },
    {
      "name": "failed_lowercase_headers",
      "body_fixture": [
        "sent-email-events",
        "failed-recipient.json"
      ],
      "headers": {
        "primitive-signature": "{signed}",
        "x-webhook-event": "sent_email.failed"
      },
      "secret": "whsec_test_sent_email",
      "expected": {
        "valid": true,
        "event": "sent_email.failed",
        "id": "1a2b3c4d-0003-4000-8000-000000000003"
      }
    },
    {
      "name": "completed_signed",
      "body_fixture": [
        "sent-email-events",
        "completed.json"
      ],
      "headers": {
        "Primitive-Signature": "{signed}",
        "X-Webhook-Event": "sent_email.completed"
      },
      "secret": "whsec_test_sent_email",
      "expected": {
        "valid": true,
        "event": "sent_email.completed",
        "id": "1a2b3c4d-0007-4000-8000-000000000007"
      }
    },
    {
      "name": "wrong_secret",
      "body_fixture": [
        "sent-email-events",
        "delivered-recipient.json"
      ],
      "headers": {
        "Primitive-Signature": "{signed}",
        "X-Webhook-Event": "sent_email.delivered"
      },
      "secret": "whsec_wrong",
      "sign_secret": "whsec_test_sent_email",
      "expected": {
        "valid": false,
        "error_code": "SIGNATURE_MISMATCH"
      }
    },
    {
      "name": "expired_signature",
      "body_fixture": [
        "sent-email-events",
        "delivered-recipient.json"
      ],
      "headers": {
        "Primitive-Signature": "{signed}",
        "X-Webhook-Event": "sent_email.delivered"
      },
      "secret": "whsec_test_sent_email",
      "timestamp": 1734567000,
      "expected": {
        "valid": false,
        "error_code": "TIMESTAMP_OUT_OF_RANGE"
      }
    },
    {
      "name": "missing_signature",
      "body_fixture": [
        "sent-email-events",
        "delivered-recipient.json"
      ],
      "headers": {
        "X-Webhook-Event": "sent_email.delivered"
      },
      "secret": "whsec_test_sent_email",
      "expected": {
        "valid": false,
        "error_code": "INVALID_SIGNATURE_HEADER"
      }
    },
    {
      "name": "signed_but_malformed",
      "body": "{\"id\":\"evt_x\",\"event\":\"sent_email.completed\"}",
      "headers": {
        "Primitive-Signature": "{signed}",
        "X-Webhook-Event": "sent_email.completed"
      },
      "secret": "whsec_test_sent_email",
      "expected": {
        "valid": false,
        "error_code": "SCHEMA_VALIDATION_FAILED"
      }
    }
  ]
}
