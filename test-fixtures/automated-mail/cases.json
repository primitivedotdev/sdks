        "automated": true,
        "reasons": [
          "list_unsubscribe",
          "list_id"
        ]
      }
    },
    {
      "name": "empty header values declare nothing",
      "email": {
        "sender": "alex@example.com",
        "smtp_mail_from": null,
        "from_header": "alex@example.com",
        "recipient": "agent@acme.test",
        "smtp_rcpt_to": null,
        "to_addresses": null,
        "automation_headers": {
          "list_unsubscribe": "  ",
          "list_id": "",
          "precedence": " "
        }
      },
      "own_domains": [],
      "expected": {
        "automated": false,
        "reasons": []
      }
    },
    {
      "name": "non-string header values are ignored",
      "email": {
        "sender": "alex@example.com",
        "smtp_mail_from": null,
        "from_header": "alex@example.com",
        "recipient": "agent@acme.test",
        "smtp_rcpt_to": null,
        "to_addresses": null,
        "automation_headers": {
          "list_unsubscribe": 1,
          "precedence": [
            "bulk"
          ],
          "auto_submitted": null
        }
      },
      "own_domains": [],
      "expected": {
        "automated": false,
        "reasons": []
      }
    },
    {
      "name": "every loop rule and every declared header together, in rule order",
      "email": {
        "sender": "",
        "smtp_mail_from": "",
        "from_header": "MAILER-DAEMON@acme.test",
        "recipient": "agent@acme.test",
        "smtp_rcpt_to": null,
        "to_addresses": null,
        "automation_headers": {
          "list_id": "<l>",
          "list_unsubscribe": "<u>",
          "precedence": "list",
          "auto_submitted": "auto-generated"
        }
      },
      "own_domains": [
        "acme.test"
      ],
      "expected": {
        "automated": true,
        "reasons": [
          "null_envelope_sender",
          "own_address",
          "mailer_daemon",
          "auto_submitted",
          "precedence",
          "list_unsubscribe",
          "list_id"
        ]
      }
    }
  ]
}
