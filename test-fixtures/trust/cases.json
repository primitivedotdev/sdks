      "auth": {
        "spf": "pass",
        "dmarc": "temperror",
        "dmarcPolicy": null,
        "dmarcFromDomain": "example.com",
        "dmarcSpfAligned": false,
        "dmarcDkimAligned": false,
        "dmarcSpfStrict": false,
        "dmarcDkimStrict": false,
        "dkimSignatures": []
      },
      "options": { "domain": "example.com" },
      "expected": {
        "trusted": false,
        "retryable": true,
        "reason": "dmarc-temperror"
      }
    },
    {
      "name": "dmarc-permerror-is-not-retryable",
      "from": "sender@example.com",
      "auth": {
        "spf": "pass",
        "dmarc": "permerror",
        "dmarcPolicy": null,
        "dmarcFromDomain": "example.com",
        "dmarcSpfAligned": false,
        "dmarcDkimAligned": false,
        "dmarcSpfStrict": false,
        "dmarcDkimStrict": false,
        "dkimSignatures": []
      },
      "options": { "domain": "example.com" },
      "expected": {
        "trusted": false,
        "retryable": false,
        "reason": "auth-unknown"
      }
    },
