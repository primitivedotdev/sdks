{
  "description": "Incremental conversation sync over GET /emails/{id}/conversation?since=. Each case starts from `state` (null means a first sync, which reads since=start), serves `pages` in order (each page asserts the `since` the client sent), and expects the merged messages in order with their copy ids and, where given, status, plus the final cursor; or an error. Merge rule: upsert by id; two entries are the same message when either one's id is in the other's copies or sent_email_id, and the newer one replaces the held one in its place; order by timestamp, then by held position. `timestamps` pins how a message timestamp is normalized (`normalized`, null when it is not a valid RFC 3339 date-time; no offset means UTC) and the epoch milliseconds it sorts by (`ms`, fraction truncated).",
  "cases": [
    {
      "name": "a delta adds a copy to a held message",
      "state": {
        "cursor": "cursor-1",
        "messages": [
          {
            "role": "user",
            "direction": "inbound",
            "id": "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a1a1",
            "message_id": "<a1a1a1a1@example.test>",
            "from": "ada@example.test",
            "to": "support@example.test",
            "subject": "Invoice",
            "text": "Where is my invoice?",
            "timestamp": "2026-03-01T10:00:00.000Z",
            "copies": [
              {
                "id": "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a1a1",
                "recipient": "support@example.test"
              }
            ]
          },
          {
            "role": "assistant",
            "direction": "outbound",
            "id": "f6f6f6f6-f6f6-4f6f-8f6f-f6f6f6f6f6f6",
            "message_id": "<f6f6f6f6@example.test>",
            "from": "agent@example.test",
            "to": "ada@example.test",
            "subject": "Re: Invoice",
            "text": "Looking into it.",
            "timestamp": "2026-03-01T10:05:00.000Z",
            "status": "delivered"
          }
        ]
      },
      "pages": [
        {
          "since": "cursor-1",
          "response": {
            "success": true,
            "data": {
              "thread_id": "0c0c0c0c-0c0c-4c0c-8c0c-0c0c0c0c0c0c",
              "subject": "Invoice",
              "message_count": 2,
              "truncated": false,
              "messages": [
                {
                  "role": "user",
                  "direction": "inbound",
                  "id": "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a1a1",
                  "message_id": "<a1a1a1a1@example.test>",
                  "from": "ada@example.test",
                  "to": "support@example.test",
                  "subject": "Invoice",
                  "text": "Where is my invoice?",
                  "timestamp": "2026-03-01T10:00:00.000Z",
                  "copies": [
                    {
                      "id": "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a1a1",
