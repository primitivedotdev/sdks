{
  "name": "@primitivedotdev/api-core",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace-internal package: TypeScript OpenAPI surface (generated fetch client, operation manifest, OpenAPI document, request/response types, and the host-aware PrimitiveApiClient) shared by @primitivedotdev/sdk and primitive. Never published; both consumers bundle this module inline.",
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "generate:openapi": "tsx scripts/generate-openapi-artifacts.ts",
    "generate:api": "openapi-ts -f openapi-ts.config.ts && tsx scripts/fix-generated-api-imports.ts",
    "generate": "pnpm generate:openapi && pnpm generate:api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm --dir ../../sdk-node exec biome check --error-on-warnings ../packages/api-core/openapi-ts.config.ts ../packages/api-core/scripts ../packages/api-core/src/client.ts ../packages/api-core/src/index.ts ../packages/api-core/src/memories.ts ../packages/api-core/src/openapi/index.ts",
    "check": "pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "yaml": "^2.8.1"
  }
}
