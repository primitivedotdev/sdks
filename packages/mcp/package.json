{
  "name": "@primitivedotdev/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Primitive. Exposes core email operations (send, list, search, get, reply, inbox status, account) as MCP tools that work with Claude Desktop, Claude Code, Cursor, Codex CLI, and any other MCP client.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primitivedotdev/sdks.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://www.primitive.dev",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "primitive",
    "email",
    "agent",
    "claude",
    "cursor"
  ],
  "main": "build/index.js",
  "bin": {
    "primitive-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc && shx chmod 755 build/index.js",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "json-schema-to-zod": "^2.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-mcp-generator": "^3.3.0",
    "shx": "^0.4.0",
    "typescript": "^5.7.2"
  }
}
